# 复制为 .env 并填入你的 Key 即启用真实 LLM（默认 DeepSeek，OpenAI 兼容）
# 获取 Key：https://platform.deepseek.com → API Keys（充值后创建）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 生产首次启动必填（至少 12 位；只创建 founder 管理员，不创建演示 HR/员工账号）
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
# INITIAL_ADMIN_USERNAME=founder
# INITIAL_ADMIN_NAME=创始人

# 以下可选，不填用默认值：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# （OpenAI：LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini）
# （阿里云百炼兼容：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus）
