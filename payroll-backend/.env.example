# 复制为 .env 后可配置外部 LLM（默认 DeepSeek，OpenAI 兼容）
# 获取 Key：https://platform.deepseek.com → API Keys（充值后创建）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 双重开关：只有这里显式为 true，且用户在界面逐次同意，脱敏问题才会发往外部模型。
COPILOT_EXTERNAL_LLM=false
# 简历包含高度敏感信息，必须单独开启；仍需用户逐次同意，正文会先在本地脱敏。
RESUME_EXTERNAL_LLM=false

# 首次启动必填（至少 12 位；只创建 founder 管理员，不创建任何演示业务数据）
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
# INITIAL_ADMIN_USERNAME=founder
# INITIAL_ADMIN_NAME=CEO

# 仅本地演示时显式开启；生产环境严禁设置为 true
# DEMO_MODE=false

# 前端来源白名单（逗号分隔）。开发环境允许 localhost / 127.0.0.1；production 仅允许此列表
# CORS_ORIGINS=https://payroll.example.com
# DB_PATH=/var/lib/payroll/payroll.db
# UPLOAD_DIR=/var/lib/payroll/uploads
# 经薪税负责人核验的政策 JSON；须含有效期、来源、基数、逐险种费率、最低工资与上年社平工资。
# 只有 verified=true、字段完整且个人养老/医疗/失业费率之和等于个人社保总费率的记录才允许月结。
# CITY_POLICY_FILE=/etc/payroll/city-policies.json

# 以下可选，不填用默认值：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# （OpenAI：LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini）
# （阿里云百炼兼容：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus）
